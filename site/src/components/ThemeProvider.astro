{/* Same as Starlight's, except a first visit defaults to dark instead of following the OS. */}
<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem('starlight-theme');
			if (stored === null) localStorage.setItem('starlight-theme', (stored = 'dark'));
		} catch {}
		const theme =
			stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
	})();
</script>
