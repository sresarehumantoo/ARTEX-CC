    <script>
      import '../scripts/motion.ts';
      import '../scripts/landing-motion.ts';

      document.addEventListener('click', async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button[data-copy]');
        if (!button) return;
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          button.textContent = 'Copied';
          button.dataset.copyState = 'copied';
        } catch {
          button.textContent = 'Failed';
          button.dataset.copyState = 'failed';
        }
        setTimeout(() => {
          button.textContent = 'Copy';
          delete button.dataset.copyState;
        }, 1500);
      });

      for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const select = (tab: HTMLButtonElement) => {
          for (const t of tabs) {
            const on = t === tab;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
          }
          tab.focus();
        };
        root.addEventListener('click', (e) => {
          const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
          if (tab) select(tab);
        });
        root.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
          if (i < 0) return;
          if (e.key === 'ArrowRight') select(tabs[(i + 1) % tabs.length]);
          if (e.key === 'ArrowLeft') select(tabs[(i - 1 + tabs.length) % tabs.length]);
        });
      }
    </script>
