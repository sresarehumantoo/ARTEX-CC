---
import { analyticsBeacon } from '../analytics.mjs';
import '../styles/landing.css';
import '../styles/motion.css';
import '../styles/landing-motion.css';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Command from '../components/Command.astro';
import toolStats from '../data/tool-stats.json';
import logo from '../../../docs/brand/logo-dark.svg';
import architecture from '../../../docs/architecture.svg';
import webDemoMp4 from '../../../docs/web-demo.mp4?url';
import webDemoPoster from '../../../docs/web-demo-poster.png';
import graph from '../../../docs/screenshots/graph.png';
import findingDetail from '../../../docs/screenshots/finding-detail.png';
import traffic from '../../../docs/screenshots/traffic.png';
import coverage from '../../../docs/screenshots/coverage.png';
import assets from '../../../docs/screenshots/assets.png';
import report from '../../../docs/screenshots/report.png';

const repo = 'https://github.com/SREsAreHumanToo/ARTEX-CC';
const title = 'ARTEX-CC: use your Claude subscription to run pentests';
const description =
  'An MCP server that gives Claude Code an asset graph, exploration tracking, findings, coverage, traffic capture and reporting. No API key needed.';
const canonical = new URL('/', Astro.site).href;

const changelog = await getEntry('repo', 'changelog');
const version = changelog?.body?.match(/^## \[(\d+\.\d+\.\d+)\]/m)?.[1];

const nav = [
  { label: 'Docs', href: '/docs/getting-started/' },
  { label: 'Tools', href: '/docs/tools/' },
  { label: 'Evals', href: '/evals/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Changelog', href: '/changelog/' },
];

const props = [
  {
    title: 'No API cost',
    body: 'Your Claude subscription covers it. No API key, no token counting, no surprise bills. ARTEX has no LLM client of its own.',
  },
  {
    title: "Claude's full reasoning",
    body: 'Not a constrained agent loop: Claude Code drives the engagement with its whole context window, tool use and subagents.',
  },
  {
    title: 'Your judgment in the loop',
    body: 'Claude proposes, you approve. The exploration graph lets you review the plan, steer it with hints, and resume hours later.',
  },
];

const session = [
  { phase: 'orient', tool: 'graph_overview', arg: '' },
  { phase: '', tool: 'set_goals', arg: '' },
  { phase: 'recon', tool: 'insert_assets', arg: 'domain: example.com' },
  { phase: '', tool: 'add_intent', arg: 'enumerate subdomains' },
  { phase: '', tool: 'record_fact', arg: 'found: api.example.com' },
  { phase: '', tool: 'insert_assets', arg: 'subdomain: api.example.com, service: https/443' },
  { phase: 'plan', tool: 'add_intent', arg: 'test api.example.com for auth bypass' },
  { phase: 'test', tool: 'start_intent', arg: 'claim the auth bypass intent' },
  { phase: '', tool: 'traffic_hosts', arg: '' },
  { phase: '', tool: 'traffic_search', arg: 'host: api.example.com' },
  { phase: '', tool: 'traffic_get', arg: 'inspect the auth request' },
  { phase: '', tool: 'traffic_replay', arg: 'replay with modified auth header' },
  { phase: 'record', tool: 'record_coverage', arg: 'api /admin, idor, no_issue_found' },
  { phase: '', tool: 'report_finding', arg: 'severity: high, broken access control on /api/v2/users' },
  { phase: 'prove', tool: 'prove_goal', arg: 'evidence: finding #1' },
  { phase: '', tool: 'generate_report', arg: '' },
];

const forest = [
  { phase: 'Recon', body: 'nmap found a Windows Server 2016 DC for htb.local. An RPC null session leaked the full user list.' },
  { phase: 'Foothold', body: 'svc-alfresco had Kerberos pre-auth disabled. AS-REP roast, cracked with hashcat, WinRM in, user.txt.' },
  { phase: 'Domain Admin', body: 'Account Operators to a new user in Exchange Windows Permissions, WriteDACL, DCSync, pass-the-hash, root.txt.' },
  { phase: 'Cleanup', body: 'Restored the domain DACL, deleted the created user, removed uploaded scripts.' },
];

const shots = [
  { src: graph, label: 'Exploration graph', alt: 'Exploration graph of goals, intents, facts and findings' },
  { src: findingDetail, label: 'Findings with bound traffic', alt: 'Finding detail with the captured request and response bound as evidence' },
  { src: traffic, label: 'Recording proxy', alt: 'Captured traffic list from the recording proxy' },
  { src: coverage, label: 'Coverage matrix', alt: 'Coverage matrix of surfaces against risk areas' },
  { src: assets, label: 'Assets', alt: 'Asset inventory of domains, IPs and services' },
  { src: report, label: 'Engagement report', alt: 'Printable engagement report' },
];

const install = [
  {
    id: 'brew',
    label: 'Homebrew',
    note: 'macOS and Linux (Homebrew 7.0.11 or later).',
    command: 'brew install --cask sresarehumantoo/tap/artex-cc',
  },
  {
    id: 'docker',
    label: 'Docker',
    note: 'PostgreSQL and ARTEX together, web UI on :9400, recording proxy on :8788.',
    command: `git clone ${repo}.git\ncd ARTEX-CC\ndocker compose up`,
  },
  {
    id: 'binaries',
    label: 'Binaries',
    note: 'Linux, macOS and Windows archives with checksums, on every release.',
    link: { href: `${repo}/releases/latest`, label: 'Download the latest release' },
  },
  {
    id: 'source',
    label: 'Source',
    note: 'Requires Go 1.26 or later.',
    command: 'go install github.com/SREsAreHumanToo/ARTEX-CC/cmd/artex-cc@latest',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ARTEX-CC" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/social-preview.png', Astro.site).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline {...analyticsBeacon}></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-sky-400 focus:px-3 focus:py-2 focus:text-neutral-950"
      >Skip to content</a
    >

    <header data-nav class="sticky top-0 z-40 border-b border-line bg-ink/70 backdrop-blur-xl backdrop-saturate-150">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-4 sm:px-6">
        <a href="/" class="shrink-0 rounded-md" aria-label="ARTEX-CC home">
          <img src={logo.src} alt="ARTEX-CC" width="134" height="28" class="h-7 w-auto" />
        </a>
        <nav class="flex items-center gap-0.5 text-sm" aria-label="Main">
          {
            nav.map((item, i) => (
              <a
                href={item.href}
                class:list={[
                  'rounded-md px-3 py-1.5 text-neutral-400 transition-colors hover:bg-white/5 hover:text-neutral-100',
                  i > 0 && 'hidden md:inline-block',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={repo}
            aria-label="GitHub"
            class="ml-2 inline-flex items-center gap-2 rounded-md border border-line bg-white/[0.03] px-3 py-1.5 text-neutral-200 transition-colors hover:border-white/20 hover:bg-white/[0.06] hover:text-white"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            <span class="hidden sm:inline">GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section id="hero" class="relative overflow-hidden border-b border-line" data-spotlight-area>
        <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true" data-hero-grid></div>
        <div class="pointer-events-none absolute inset-0 hidden" aria-hidden="true" data-traces>
          <span></span><span></span>
        </div>
        <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true" data-hero-glow></div>
        <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-28 sm:pb-28">
          <div class="flex flex-col items-start sm:items-center sm:text-center">
            <a
              href="/changelog/"
              class="group inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-line bg-white/[0.03] px-3 py-1 font-mono text-[10px] text-neutral-400 uppercase transition-colors hover:border-white/20 hover:text-neutral-200 sm:text-[11px] sm:tracking-wide"
              data-enter
            >
              <span class="size-1.5 rounded-full bg-sky-400 shadow-[0_0_8px] shadow-sky-400" aria-hidden="true" data-pulse></span>
              {version && <span><span class="normal-case">v{version}</span> &middot;</span>}
              <span>Open source, AGPL-3.0 &middot;</span>
              <span class="inline-flex items-center gap-1 text-sky-300"
                >Changelog <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span></span
              >
            </a>
            <h1
              class="mt-7 max-w-4xl text-[2.5rem] leading-[1.05] font-semibold tracking-tighter text-balance sm:text-6xl lg:text-7xl"
            >
              <span class="text-gradient"
                >Use your <span data-highlight>Claude subscription</span> to run <span data-highlight>pentests</span>.</span
              >{' '}
              <span class="text-gradient-muted block pb-1">No API key needed.</span>
            </h1>
            <p class="mt-6 max-w-2xl text-base leading-relaxed text-pretty text-neutral-400 sm:text-lg" data-enter style="--enter-i: 1">
              ARTEX-CC gives Claude Code an asset graph, exploration tracking, findings, coverage, traffic capture and
              reporting as {toolStats.tools} MCP tools. Claude decides what to test. ARTEX keeps the record of what was tested, what
              was found, and what is left.
            </p>

            <Command
              command="brew install --cask sresarehumantoo/tap/artex-cc"
              class="mt-9 w-full max-w-xl text-left shadow-lg shadow-black/40"
              data-enter=""
              style="--enter-i: 2"
            />

            <div class="mt-6 flex flex-wrap items-center gap-3 sm:justify-center" data-enter style="--enter-i: 3">
              <a
                href="/demo/"
                class="group inline-flex items-center gap-2 rounded-lg bg-sky-400 px-5 py-2.5 text-sm font-semibold text-neutral-950 shadow-[0_0_0_1px_oklch(0.85_0.1_230),0_8px_24px_-6px_oklch(0.75_0.14_232/0.6)] transition hover:bg-sky-300"
                data-sheen
              >
                Try the live demo
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
              </a>
              <a
                href="/docs/getting-started/"
                class="inline-flex items-center rounded-lg border border-line bg-white/[0.03] px-5 py-2.5 text-sm font-medium text-neutral-100 transition-colors hover:border-white/20 hover:bg-white/[0.06]"
              >
                Get started
              </a>
              <a
                href={repo}
                class="inline-flex items-center rounded-lg px-3 py-2.5 text-sm font-medium text-neutral-400 transition-colors hover:text-neutral-100"
              >
                View on GitHub
              </a>
            </div>
          </div>

          <figure class="frame-ring mt-16 sm:mt-20" data-enter="lift" style="--enter-i: 4">
            <div class="overflow-hidden rounded-[calc(var(--radius-2xl)-1px)] bg-panel">
              <div class="flex items-center gap-4 border-b border-line bg-white/[0.02] px-4 py-3">
                <div class="flex gap-1.5" aria-hidden="true">
                  <span class="size-2.5 rounded-full bg-neutral-700"></span>
                  <span class="size-2.5 rounded-full bg-neutral-700"></span>
                  <span class="size-2.5 rounded-full bg-neutral-700"></span>
                </div>
                <span class="font-mono text-xs text-neutral-400">artex-cc serve --web</span>
              </div>
              <video
                width={webDemoPoster.width}
                height={webDemoPoster.height}
                poster={webDemoPoster.src}
                aria-label="ARTEX-CC web UI walkthrough: dashboard, exploration graph, findings, traffic, coverage and report"
                class="block h-auto w-full"
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              >
                <source src={webDemoMp4} type="video/mp4" />
              </video>
            </div>
          </figure>
        </div>
      </section>

      <section id="why" class="relative border-b border-line">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28" data-reveal-children>
          <p class="eyebrow">Architecture</p>
          <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
            You bring the brain. ARTEX brings the hands.
          </h2>
          <p class="mt-5 max-w-2xl leading-relaxed text-neutral-400">
            Upstream ARTEX ships its own LLM agent loop, which needs an API key and a token budget. If you already pay
            for Claude, that is a second brain doing the same job. ARTEX-CC removes the loop and exposes the data layer
            as MCP tools, so Claude Code becomes the agent.
          </p>
          <div class="card mt-12 p-3 sm:p-8">
            <Image
              src={architecture}
              alt={`Claude Code, the brain, calls ARTEX-CC over MCP. ARTEX exposes ${toolStats.tools} tools in ${toolStats.categories} categories, stores state in PostgreSQL and captures traffic through its recording proxy.`}
              class="mx-auto h-auto w-full max-w-4xl"
              loading="lazy"
            />
          </div>
          <ol class="mt-6 grid gap-4 sm:grid-cols-3" data-reveal-children>
            {
              props.map((p, i) => (
                <li class="card p-6 transition-colors hover:border-white/15" data-spotlight>
                  <span class="inline-flex size-8 items-center justify-center rounded-md border border-sky-400/25 bg-sky-400/10 font-mono text-xs text-sky-300">
                    0{i + 1}
                  </span>
                  <h3 class="mt-5 font-semibold text-white">{p.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-400">{p.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="session" class="relative border-b border-line">
        <div class="mx-auto grid max-w-6xl items-start gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-5 lg:gap-16">
          <div class="lg:col-span-2 lg:sticky lg:top-28" data-reveal-children>
            <p class="eyebrow">Session</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">What a session looks like</h2>
            <p class="mt-5 leading-relaxed text-neutral-400">
              You ask for a pentest. Claude picks the tools. Every call lands in the exploration graph, so Claude
              always knows where it has been, what it found, and what it planned next.
            </p>
            <p class="mt-4 leading-relaxed text-neutral-400">
              Stop for the night and the graph is still there. The next session starts with{' '}
              <code class="rounded border border-line bg-white/5 px-1.5 py-0.5 font-mono text-[0.85em] text-neutral-200"
                >graph_overview</code
              > and picks up where the last one left off.
            </p>
            <a
              href="/docs/walkthrough/"
              class="group mt-7 inline-flex items-center gap-1.5 text-sm font-medium text-sky-400 transition-colors hover:text-sky-300"
              >Read the full walkthrough <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
                >&rarr;</span
              ></a
            >
          </div>
          <div
            data-reveal
            class="overflow-hidden rounded-xl border border-line bg-[oklch(0.12_0_0)] font-mono text-[12.5px] shadow-2xl shadow-black/50 sm:text-[13px] lg:col-span-3"
          >
            <div class="flex items-center gap-4 border-b border-line bg-white/[0.02] px-4 py-3">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-neutral-700"></span>
                <span class="size-2.5 rounded-full bg-neutral-700"></span>
                <span class="size-2.5 rounded-full bg-neutral-700"></span>
              </div>
              <span class="text-xs text-neutral-500">claude</span>
            </div>
            <div class="border-b border-line px-4 py-3.5 text-neutral-200">
              <span class="text-sky-400">&gt;</span> Pentest example.com, starting with reconnaissance.
            </div>
            <ol class="px-4 py-4" data-stream>
              {
                session.map((s, i) => (
                  <li
                    class:list={[
                      'grid grid-cols-[4rem_1fr] gap-x-3 leading-6 sm:grid-cols-[4.5rem_1fr]',
                      s.phase && i > 0 && 'mt-2.5 border-t border-dashed border-white/[0.06] pt-2.5',
                    ]}
                  >
                    <span class="text-[11px] tracking-wider text-neutral-500 uppercase">{s.phase}</span>
                    <span class="flex gap-2.5">
                      <span class="mt-[9px] size-1.5 shrink-0 rounded-full bg-emerald-400/80" aria-hidden="true" data-stream-dot></span>
                      <span>
                        <span class="whitespace-nowrap text-sky-300">{s.tool}</span>
                        {s.arg && <span class="text-neutral-500"> ({s.arg})</span>}
                      </span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section id="eval" class="relative overflow-clip border-b border-line">
        <div class="section-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28" data-reveal-children>
          <p class="eyebrow">Eval</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">HTB Forest, fully blind</h2>
          <p class="mt-5 max-w-2xl leading-relaxed text-neutral-400">
            ARTEX and Claude Opus 5.5 against Forest, a classic Active Directory box. No web searches, no writeups, no
            hints. The agent also worked around two tooling failures on its own: PowerView under non-interactive WinRM
            and the OpenSSL 3 MD4 deprecation.
          </p>
          <dl class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4" data-reveal-children>
            <div class="card p-5 sm:p-6" data-spotlight>
              <dt class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Flags</dt>
              <dd class="mt-2 font-mono text-2xl font-medium tracking-tight text-white sm:text-3xl">2 / 2</dd>
            </div>
            <div class="card p-5 sm:p-6" data-spotlight>
              <dt class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Wall clock</dt>
              <dd class="mt-2 font-mono text-2xl font-medium tracking-tight text-white sm:text-3xl">~8 min</dd>
            </div>
            <div class="card p-5 sm:p-6" data-spotlight>
              <dt class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Web lookups</dt>
              <dd class="mt-2 font-mono text-2xl font-medium tracking-tight text-white sm:text-3xl">0</dd>
            </div>
            <div class="card p-5 sm:p-6" data-spotlight>
              <dt class="text-xs font-medium tracking-wide text-neutral-500 uppercase">Target</dt>
              <dd class="mt-2 font-mono text-2xl font-medium tracking-tight text-white sm:text-3xl">AD DC</dd>
            </div>
          </dl>
          <ol class="card mt-4 divide-y divide-line px-5 sm:px-6" data-timeline>
            {
              forest.map((f, i) => (
                <li class="grid gap-1.5 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
                  <span class="flex items-center gap-3 font-mono text-sm text-sky-400">
                    <span class="text-neutral-600" data-timeline-step>{String(i + 1).padStart(2, '0')}</span>
                    {f.phase}
                  </span>
                  <span class="text-sm leading-relaxed text-neutral-300">{f.body}</span>
                </li>
              ))
            }
          </ol>
          <a
            href="/evals/htb-forest/"
            class="group mt-7 inline-flex items-center gap-1.5 text-sm font-medium text-sky-400 transition-colors hover:text-sky-300"
            >Read the eval <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span></a
          >
        </div>
      </section>

      <section id="web-ui" class="relative border-b border-line">
        <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28" data-reveal-children>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow">Web UI</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Watch it work</h2>
              <p class="mt-5 max-w-2xl leading-relaxed text-neutral-400">
                <code class="rounded border border-line bg-white/5 px-1.5 py-0.5 font-mono text-[0.85em] text-neutral-200"
                  >serve --web</code
                > adds a dashboard on the MCP port. Everything Claude records shows up live.
              </p>
            </div>
            <a
              href="/demo/"
              class="group inline-flex items-center gap-2 rounded-lg border border-sky-400/30 bg-sky-400/5 px-4 py-2 text-sm font-medium text-sky-300 transition-colors hover:border-sky-400/60 hover:bg-sky-400/10 hover:text-sky-200"
            >
              Open the live demo <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </a>
          </div>
          <ul class="mt-12 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3" data-reveal-children>
            {
              shots.map((s) => (
                <li class="card group overflow-hidden p-2 transition-colors hover:border-white/15" data-spotlight>
                  <figure>
                    <div class="overflow-hidden rounded-lg border border-line">
                      <Image
                        src={s.src}
                        alt={s.alt}
                        widths={[480, 960]}
                        sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 100vw"
                        class="h-auto w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                        loading="lazy"
                      />
                    </div>
                    <figcaption class="px-2 pt-3 pb-1.5 text-sm font-medium text-neutral-300">{s.label}</figcaption>
                  </figure>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-xs text-neutral-500">
            Screenshots use a seeded demo engagement against reserved *.example names and documentation IP ranges.
          </p>
