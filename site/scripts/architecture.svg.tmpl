<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 450" width="920" height="450" role="img" aria-label="ARTEX-CC architecture">
  <style>
{{fontFaces}}    text { font-family: "ArtexMono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; fill: {{text}}; }
    .h { font-size: 13px; font-weight: 600; fill: {{heading}}; }
    .b { font-size: 12px; fill: {{body}}; }
    .d { fill: {{dim}}; }
    .a { fill: {{accent}}; }
    .r { text-anchor: end; }
    .box { fill: {{box}}; stroke: {{boxStroke}}; }
    .row { fill: none; stroke: {{rule}}; }
    .rule { stroke: {{rule}}; }
    .ln { stroke: {{line}}; fill: none; }
    .al { stroke: {{accent}}; fill: none; }
    .lead { stroke: {{leader}}; stroke-dasharray: 1 4; }
  </style>

  <text x="20" y="22" class="d">you: prompt, hints, approvals</text>
  <path d="M 118 30 V 52" class="ln"/>
  <path d="M 114 46 L 118 53 L 122 46" class="ln"/>

  <rect x="20.5" y="56.5" width="196" height="354" rx="5" class="box"/>
  <text x="36" y="81" class="h">claude code</text>
  <text x="36" y="99">decides what to test</text>
  <line x1="21" y1="113.5" x2="216" y2="113.5" class="rule"/>

  <rect x="32.5" y="127.5" width="172" height="44" rx="3" class="row"/>
  <text x="44" y="146" class="b">main session</text>
