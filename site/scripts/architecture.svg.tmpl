  <text x="44" y="270">claims intent #17</text>
  <text x="44" y="301" class="d">claims are leased</text>

  <line x1="21" y1="318.5" x2="216" y2="318.5" class="rule"/>
  <rect x="32.5" y="332.5" width="172" height="62" rx="3" class="row"/>
