  <text x="720" y="293">graph, findings, report</text>

  <path d="M 620 364 H 702" class="al"/>
  <path d="M 695 360 L 703 364 L 695 368" class="al"/>
  <text x="661" y="354" text-anchor="middle" class="d">recorded</text>

  <rect x="704.5" y="332.5" width="196" height="62" rx="5" class="box"/>
  <text x="720" y="357" class="h">target</text>
  <text x="720" y="377">in-scope hosts only</text>
</svg>
