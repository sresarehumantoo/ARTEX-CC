  <text x="604" y="61" class="r">{{total}} tools</text>
  <text x="336" y="79">no LLM, no API key</text>
  <line x1="321" y1="93.5" x2="620" y2="93.5" class="rule"/>

  <g>
{{rows}}  </g>
