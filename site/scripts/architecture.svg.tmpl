  <text x="44" y="367">nmap, curl, ffuf,</text>
  <text x="44" y="383">nuclei, netexec ...</text>

  <path d="M 205 150 H 240 M 205 204 H 240 M 205 258 H 240 M 240 150 V 258" class="al"/>
  <path d="M 240 204 H 318" class="al"/>
  <path d="M 311 200 L 319 204 L 311 208" class="al"/>
